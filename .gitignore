*.bin
*.img
*.img.gz
*.trx
*.chk
*.squashfs
*-extracted/
_*.extracted/
extracted/
targets/

# Secrets pulled out during analysis
*.pem
*.key
findings/*.raw

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# fw-scout output (keep the curated example, ignore ad-hoc runs)
fw-scout-report/
fw-work/

# analysis tooling and scratch dirs — not part of the published package
tools/
ghidra-work/
scripts/
netgear-report/

# research findings and analysis artifacts — NOT part of the published tool
findings/
*.pub
